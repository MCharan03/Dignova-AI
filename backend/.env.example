# ── Core ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dignova
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# ── AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ── Twilio Voice Bot ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── URLs (set to your deployed URLs) ────────────────────────────────
BACKEND_URL=https://dignova-ai-backend.onrender.com
BACKEND_URL_WS=wss://dignova-ai-backend.onrender.com
FRONTEND_URL=https://dignova-ai.vercel.app

# ── Email ────────────────────────────────────────────────────────────
SIMULATE_EMAIL=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Dignova AI

# ── n8n & Telegram ───────────────────────────────────────────────────
N8N_BASE_URL=https://your-n8n-instance.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
