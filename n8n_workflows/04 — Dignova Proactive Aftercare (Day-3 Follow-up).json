{
  "name": "04 — Dignova Proactive Aftercare (Day-3 Follow-up)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-aftercare",
        "options": {}
      },
      "name": "Webhook: Aftercare Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "aftercare-webhook"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.telegram_chat_id}}",
        "text": "=💙 *How are you feeling, {{$json.body.patient_name}}?*\n\nIt's been 3 days since your prescription for:\n_{{$json.body.medication_summary}}_\n\nAre your symptoms improving?",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": [
          [
            {
              "text": "✅ Yes, I'm better",
              "callback_data": "={{$json.body.yes_callback}}"
            },
            {
              "text": "🤒 No, still sick",
              "callback_data": "={{$json.body.no_callback}}"
            }
          ]
        ],
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Patient Check-in",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        304
      ],
      "id": "tg-checkin",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "name": "Telegram: Response Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        240,
        512
      ],
      "id": "tg-response"
    },
    {
      "parameters": {
        "url": "https://dignova-ai-1.onrender.com/api/n8n/webhook/aftercare-response",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "prescription_id",
              "value": "={{$json.callback_query.data.split('_')[2]}}"
            },
            {
              "name": "patient_telegram_chat_id",
              "value": "={{$json.callback_query.message.chat.id.toString()}}"
            },
            {
              "name": "response",
              "value": "={{$json.callback_query.data.includes('yes') ? 'yes_better' : 'no_still_sick'}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Backend: Submit Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        512
      ],
      "id": "submit-response"
    },
    {
      "parameters": {
        "chatId": "={{$json.callback_query.message.chat.id}}",
        "text": "={{$json.message}}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Ack Response",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        720,
        512
      ],
      "id": "tg-ack",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Aftercare Trigger": {
      "main": [
        [
          {
            "node": "Telegram: Patient Check-in",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: Response Trigger": {
      "main": [
        [
          {
            "node": "Backend: Submit Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend: Submit Response": {
      "main": [
        [
          {
            "node": "Telegram: Ack Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
