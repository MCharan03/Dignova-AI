{
  "name": "03 — Dignova Doctor Escalation (Highlight Card + Inline Approve)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-escalate",
        "options": {}
      },
      "name": "Webhook: Escalation Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "escalate-webhook"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.doctor_telegram_chat_id}}",
        "text": "=🚨 *CRITICAL ESCALATION: {{$json.body.highlight_title}}*\n\n👤 *Patient:* {{$json.body.patient_name}}\n⚠️ *Urgency:* {{$json.body.urgency}}\n📝 *Summary:* {{$json.body.suggested_action}}\n\n*Symptoms Detected:*\n{{$json.body.symptoms.join('\\n')}}\n\n*Red Flags:* \n{{$json.body.red_flags.join('\\n')}}\n\n_Note: {{$json.body.patient_vitals_note}}_",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": [
          [
            {
              "text": "✅ Approve Prescription",
              "callback_data": "={{$json.body.approve_callback}}"
            },
            {
              "text": "🛠 Modify / Review",
              "callback_data": "={{$json.body.modify_callback}}"
            }
          ]
        ],
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Doctor Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        304
      ],
      "id": "tg-doctor-alert",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "name": "Telegram: Callback Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        240,
        512
      ],
      "id": "tg-callback"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.callback_query.data}}",
              "operation": "startsWith",
              "value2": "approve_"
            }
          ]
        }
      },
      "name": "Is Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        512
      ],
      "id": "check-approval"
    },
    {
      "parameters": {
        "url": "https://dignova-ai-1.onrender.com/api/n8n/webhook/doctor-approval",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "call_id",
              "value": "={{$json.callback_query.data.split('_')[1]}}"
            },
            {
              "name": "action",
              "value": "approve"
            },
            {
              "name": "doctor_telegram_chat_id",
              "value": "={{$json.callback_query.message.chat.id.toString()}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Backend: Submit Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        720,
        416
      ],
      "id": "submit-approval"
    },
    {
      "parameters": {
        "chatId": "={{$json.callback_query.message.chat.id}}",
        "text": "={{$json.message}}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Confirm to Doctor",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        960,
        416
      ],
      "id": "tg-confirm",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Escalation Trigger": {
      "main": [
        [
          {
            "node": "Telegram: Doctor Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: Callback Trigger": {
      "main": [
        [
          {
            "node": "Is Approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Approval?": {
      "main": [
        [
          {
            "node": "Backend: Submit Approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend: Submit Approval": {
      "main": [
        [
          {
            "node": "Telegram: Confirm to Doctor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
