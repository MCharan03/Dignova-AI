{
  "name": "05 - Dignova Smart Calendar (HARDENED)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-calendar",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "id": "webhook"
    },
    {
      "parameters": {
        "method": "POST",
