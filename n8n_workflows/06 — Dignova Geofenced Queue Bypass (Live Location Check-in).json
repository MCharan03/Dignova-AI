{
  "name": "06 — Dignova Geofenced Queue Bypass (Live Location Check-in)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-geofence",
        "options": {}
      },
      "name": "Webhook: Geofence Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "geofence-webhook"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.patient_telegram_chat_id}}",
        "text": "=📍 *Geofence Activated*\n\nHi {{$json.body.patient_name}}, we've detected you're only {{$json.body.distance_meters}}m from the hospital.\n\n✅ *Auto Check-in Successful!*\nYou have been placed at the front of the queue. *Dr. {{$json.body.doctor_name}}* has been notified of your arrival.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Confirm to Patient",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        208
      ],
      "id": "tg-patient",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{$json.body.doctor_telegram_chat_id}}",
        "text": "=🏃‍♂️ *Subject Arriving: {{$json.body.patient_name}}*\n\nDistance: {{$json.body.distance_meters}}m\nEst. Arrival: {{$json.body.estimated_minutes}} min\n\n*Action:* Prepare triage station Node-01.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Alert Doctor",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        400
      ],
      "id": "tg-doctor",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Geofence Trigger": {
      "main": [
        [
          {
            "node": "Telegram: Confirm to Patient",
            "type": "main",
            "index": 0
          },
          {
            "node": "Telegram: Alert Doctor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
