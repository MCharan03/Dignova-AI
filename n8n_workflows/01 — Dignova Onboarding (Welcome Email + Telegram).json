{
  "name": "01 — Dignova Onboarding (Welcome Email + Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-onboarding",
        "options": {}
      },
      "name": "Webhook: Onboarding Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "onboard-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.telegram_chat_id}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Has Telegram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        304
      ],
      "id": "check-telegram"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.telegram_chat_id}}",
        "text": "👋 Welcome to *Dignova AI*, {{$json.body.name}}!\n\n🏥 You now have access to:\n• 24/7 AI medical triage\n• Instant prescriptions for minor issues\n• Doctor escalation for complex cases\n• Appointment booking\n• Proactive health reminders\n\nType your symptoms anytime to begin. I'm here to help! 💙\n\n_Dignova AI — Autonomous Healthcare Intelligence_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Welcome Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        720,
        208
      ],
      "id": "tg-welcome",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "cherrycostech@gmail.com",
        "toEmail": "={{$json.body.email}}",
        "subject": "Welcome to Dignova AI — Please Verify Your Email",
        "html": "<h1>Welcome to Dignova AI</h1><p>Hi {{$json.body.name}}, your account is ready.</p><p>Please verify your email here: <a href=\"{{$json.body.verify_url}}\">Verify Now</a></p>",
        "options": {}
      },
      "name": "Email: Welcome",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        720,
        400
      ],
      "id": "email-welcome",
      "credentials": {
        "smtp": {
          "id": "standard-smtp-id",
          "name": "Dignova Gmail SMTP"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Onboarding Trigger": {
      "main": [
        [
          {
            "node": "Has Telegram?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Telegram?": {
      "main": [
        [
          {
            "node": "Telegram: Welcome Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email: Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: Welcome Message": {
      "main": [
        [
          {
            "node": "Email: Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
