          "id": "iv5NZHCR5wjspGfE",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "https://dignova-ai.onrender.com/api/n8n/webhook/preventive-check",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "mode",
              "value": "send_email_only"
