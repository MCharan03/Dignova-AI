{
  "name": "07 — Dignova Automated Preventive Care (Annual_Semi-Annual Nudge)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-preventive",
        "options": {}
      },
      "name": "Webhook: Preventive Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "preventive-webhook"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.telegram_chat_id}}",
        "text": "=🩺 *Proactive Health Nudge*\n\nHi {{$json.body.patient_name}},\n\n{{$json.body.message}}\n\nIt's been {{$json.body.months_overdue}} months since your last assessment. Shall we schedule a quick check-up?",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": [
          [
            {
              "text": "📅 Book Check-up Now",
              "callback_data": "={{$json.body.book_callback}}"
            }
          ]
        ],
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Send Nudge",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        304
      ],
      "id": "tg-nudge",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "cherrycostech@gmail.com",
        "toEmail": "={{$json.body.email}}",
        "subject": "Dignova AI: Proactive Health Reminder",
        "html": "=<h1>Health Reminder</h1><p>Hi {{$json.body.patient_name}},</p><p>{{$json.body.message}}</p><p>Stay healthy!</p>",
        "options": {}
      },
      "name": "Email: Send Nudge",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        480,
        512
      ],
      "id": "email-nudge",
      "credentials": {
        "smtp": {
          "id": "standard-smtp-id",
          "name": "Dignova Gmail SMTP"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Preventive Trigger": {
      "main": [
        [
          {
            "node": "Telegram: Send Nudge",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email: Send Nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
