{
  "name": "07 — Dignova Automated Preventive Care (Annual/Semi-Annual Nudge)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
