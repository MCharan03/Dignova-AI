{
  "name": "05 — Dignova Smart Calendar Reminders (Google Calendar + Telegram)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dignova-calendar",
        "options": {}
      },
      "name": "Webhook: Calendar Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        304
      ],
      "id": "calendar-webhook"
    },
    {
      "parameters": {
        "chatId": "={{$json.body.telegram_chat_id}}",
        "text": "=📅 *Appointment Reminder*\n\nHi {{$json.body.patient_name}}, you have an appointment scheduled with *Dr. {{$json.body.doctor_name}}*.\n\n⏰ *Time:* {{$json.body.slot_time}}\n\nPlease confirm your attendance:",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": [
          [
            {
              "text": "✅ Confirm",
              "callback_data": "={{$json.body.confirm_callback}}"
            },
            {
              "text": "📅 Reschedule",
              "callback_data": "={{$json.body.reschedule_callback}}"
            }
          ]
        ],
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        480,
        304
      ],
      "id": "tg-reminder",
      "credentials": {
        "telegramApi": {
          "id": "standard-tg-id",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list"
        },
        "start": "={{$json.body.slot_time}}",
        "end": "={{$node[\"Webhook: Calendar Trigger\"].json.body.slot_time}}",
        "summary": "=Dignova Appointment: {{$json.body.patient_name}}",
        "description": "=Doctor: {{$json.body.doctor_name}}\nAppointment ID: {{$json.body.appointment_id}}",
        "additionalFields": {
          "attendees": [
            "={{$json.body.patient_email}}"
          ]
        }
      },
      "name": "Google Calendar: Sync",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [
        720,
        208
      ],
      "id": "gcal-sync",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "standard-gcal-id",
          "name": "Dignova Google Calendar"
        }
      }
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "name": "Telegram: Action Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        240,
        512
      ],
      "id": "tg-action"
    },
    {
      "parameters": {
        "url": "https://dignova-ai-1.onrender.com/api/n8n/webhook/calendar-action",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "appointment_id",
              "value": "={{$json.callback_query.data.split('_')[2]}}"
            },
            {
              "name": "patient_telegram_chat_id",
              "value": "={{$json.callback_query.message.chat.id.toString()}}"
            },
            {
              "name": "action",
              "value": "={{$json.callback_query.data.includes('confirm') ? 'confirm' : 'reschedule'}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Backend: Submit Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        480,
        512
      ],
      "id": "submit-action"
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook: Calendar Trigger": {
      "main": [
        [
          {
            "node": "Telegram: Reminder",
            "type": "main",
            "index": 0
          },
          {
            "node": "Google Calendar: Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: Action Trigger": {
      "main": [
        [
          {
            "node": "Backend: Submit Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "callerPolicy": "workflowsFromSameOwner"
  }
}
