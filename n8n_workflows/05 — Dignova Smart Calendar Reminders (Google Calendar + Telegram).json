{
  "name": "05 — Dignova Smart Calendar Reminders (Google Calendar + Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "name": "Cron: Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        208,
        432
      ],
      "id": "cron-hourly"
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "start": "2026-03-17T12:52:00",
        "end": "2026-03-17T13:51:47",
        "additionalFields": {}
      },
      "name": "Google Calendar: Get Events Next 25h",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        432,
        432
      ],
      "id": "gcal-events",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GCAL_CREDENTIAL_ID",
          "name": "Dignova Google Calendar"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{(new Date($json.start.dateTime) - new Date()) / 3600000}}",
              "operation": "largerEqual",
              "value2": 23
            },
            {
              "value1": "={{(new Date($json.start.dateTime) - new Date()) / 3600000}}",
              "operation": "smallerEqual",
              "value2": 25
            }
          ]
        }
      },
      "name": "Event in 24h Window?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        656,
        432
      ],
      "id": "check-24h"
    },
    {
      "parameters": {
        "url": "https://dignova-ai.onrender.com/api/appointments/by-google-event/={{$json.id}}",
        "options": {}
      },
      "name": "Backend: Get Appointment Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        880,
        432
      ],
      "id": "get-apt"
    },
    {
      "parameters": {
        "chatId": "={{$json.patient_telegram_chat_id}}",
        "text": "📅 *Appointment Reminder — Dignova AI*\n\nHi {{$json.patient_name}}! This is your 24-hour reminder.\n\n👨‍⚕️ *Doctor:* Dr. {{$json.doctor_name}}\n⏰ *Time:* {{$json.slot_time}}\n\nPlease confirm your attendance:",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Appointment Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1104,
        432
      ],
      "id": "tg-reminder",
      "webhookId": "f1edab31-1491-462c-a842-c5480d56be0d",
      "credentials": {
        "telegramApi": {
          "id": "iv5NZHCR5wjspGfE",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "name": "Telegram: Calendar Callback",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        208,
        208
      ],
      "id": "tg-cal-callback",
      "webhookId": "ee5ba9fe-3f91-4b7b-aaf0-e8809a184023",
      "credentials": {
        "telegramApi": {
          "id": "iv5NZHCR5wjspGfE",
          "name": "Dignova Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "https://dignova-ai.onrender.com/api/n8n/webhook/calendar-action",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "appointment_id",
              "value": "={{$json.callback_query.data.replace('cal_confirm_','').replace('cal_reschedule_','')}}"
            },
            {
              "name": "patient_telegram_chat_id",
              "value": "={{$json.callback_query.from.id}}"
            },
            {
              "name": "action",
              "value": "={{$json.callback_query.data.startsWith('cal_confirm_') ? 'confirm' : 'reschedule'}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Backend: Calendar Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        432,
        208
      ],
      "id": "backend-cal"
    },
    {
      "parameters": {
        "chatId": "={{$('Telegram: Calendar Callback').item.json.callback_query.from.id}}",
        "text": "={{$json.message}}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Confirm Calendar Action",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        656,
        208
      ],
      "id": "tg-cal-confirm",
      "webhookId": "9ae3cf40-ba22-4275-9d4d-93593ae8a945",
      "credentials": {
        "telegramApi": {
          "id": "iv5NZHCR5wjspGfE",
          "name": "Dignova Telegram Bot"
        }
      }
    }
  ],
